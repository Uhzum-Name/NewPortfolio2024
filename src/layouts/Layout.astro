---
import { assetVersion } from '../assetVersion';

export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  bodyClass?: string;
  isHome?: boolean;
}

const {
  title,
  description,
  ogImage = 'https://cdn.prod.website-files.com/6659888a1845a6ee299bdaa6/68e4110855d244b0b7f56545_openg.png',
  bodyClass = 'body-2',
  isHome = false,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href={`/css/normalize.css?v=${assetVersion}`} rel="stylesheet" />
    <link href={`/css/webflow-base.css?v=${assetVersion}`} rel="stylesheet" />
    <link href={`/css/azzum-studio.webflow.css?v=${assetVersion}`} rel="stylesheet" />

    <link href="/images/favicon.png" rel="shortcut icon" type="image/x-icon" />
    <link href="/images/webclip.png" rel="apple-touch-icon" />

    <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/gh/timothydesign/script/split-type.js"></script>
    <script is:inline src="https://unpkg.com/lenis@1.1.2/dist/lenis.min.js"></script>

    <style is:global>
      /* Base font size for larger screens */
      html {
        font-size: 16px;
      }
      /* Medium screens */
      @media (max-width: 1200px) {
        html {
          font-size: 14px;
        }
      }
      /* Small screens */
      @media (max-width: 992px) {
        html {
          font-size: 14px;
        }
      }
      /* Extra small screens */
      @media (max-width: 768px) {
        html {
          font-size: 13px;
        }
      }
      html.lenis,
      html.lenis body {
        height: auto;
      }
      .lenis.lenis-smooth {
        scroll-behavior: auto !important;
      }
      .lenis.lenis-smooth [data-lenis-prevent] {
        overscroll-behavior: contain;
      }
      .lenis.lenis-stopped {
        overflow: hidden;
      }
      .lenis.lenis-smooth iframe {
        pointer-events: none;
      }
      body::-webkit-scrollbar {
        display: none;
      }
      ul,
      ol {
        list-style-type: disc !important;
        list-style-position: outside !important;
        padding-left: 20px;
      }
      ul li,
      ol li {
        display: list-item !important;
        list-style-type: disc !important;
        list-style-position: outside !important;
      }
      ul ul,
      ol ol {
        list-style-type: circle !important;
        list-style-position: outside !important;
      }
      ul ul li,
      ol ol li {
        display: list-item !important;
        list-style-type: circle !important;
        list-style-position: outside !important;
      }

      /* Text-split typewriter reveal (SplitType + GSAP), see /js/site.js */
      html:not(.w-editor) [data-text-split] {
        visibility: hidden;
      }
      .char {
        display: inline-block;
      }
      .word {
        white-space: nowrap;
      }

      /* Scroll-into-view fade/blur reveal, replaces Webflow's IX2
         "SCROLL_INTO_VIEW -> FADE_EFFECT" interaction. See /js/site.js */
      [data-reveal] {
        transition: opacity 0.6s ease, filter 0.6s ease;
      }
      [data-reveal="blur"] {
        opacity: 0;
        filter: blur(20px);
      }
      [data-reveal="fade"] {
        opacity: 0;
      }
      [data-reveal].is-visible {
        opacity: 1;
        filter: blur(0);
      }
    </style>
  </head>
  <body class={bodyClass}>
    <div class="div-block-21">
      <div class="bottomnav">
        <a href="/" class="link-block-7 w-inline-block" aria-current={isHome ? 'page' : undefined}>
          <div class="navbar-label">Azzum Naeem</div>
        </a>
      </div>
    </div>

    <slot />

    <div class="topnav">
      <div class="div-block-22">
        <div class="frame-68">
          <a href="/" class="link-block-6 nav-icon-link w-inline-block" aria-label="Home" title="Home" aria-current={isHome ? 'page' : undefined}>
            <svg class="nav-icon" viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true" focusable="false">
              <path fill="currentColor" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.3333" d="M13.3333 12.6667v-5.6667a.6667.6667 0 0 0-.2667-.5333l-4.6667-3.5a.6667.6667 0 0 0-.8 0l-4.6667 3.5a.6667.6667 0 0 0-.2667.5333V12.6667a.6667.6667 0 0 0 .6667.6667h9.3333a.6667.6667 0 0 0 .6667-.6667z" />
            </svg>
          </a>
        </div>
        <div class="frame-68">
          <a href="https://www.linkedin.com/in/azzum-naeem-a23514175" class="link-block-6 nav-icon-link w-inline-block" aria-label="LinkedIn" title="LinkedIn">
            <svg class="nav-icon" viewBox="0 0 16 16" width="16" height="16" fill="none" aria-hidden="true" focusable="false">
              <path fill="currentColor" fill-rule="evenodd" transform="translate(8 8) scale(1.08) translate(-8 -8)" d="M4 1.5H12A2.5 2.5 0 0 1 14.5 4V12A2.5 2.5 0 0 1 12 14.5H4A2.5 2.5 0 0 1 1.5 12V4A2.5 2.5 0 0 1 4 1.5ZM5.85 5a.95.95 0 1 1-1.9 0a.95.95 0 1 1 1.9 0ZM4.3 6.6H5.5a.3.3 0 0 1 .3.3V11.1a.3.3 0 0 1-.3.3H4.3a.3.3 0 0 1-.3-.3V6.9a.3.3 0 0 1 .3-.3ZM7.5 6.6H8.6A.3.3 0 0 1 8.9 6.9V7.2C9.4 6.75 10 6.5 10.7 6.5C11.6 6.5 12.1 7.2 12.1 8.4V11.1A.3.3 0 0 1 11.8 11.4H10.7A.3.3 0 0 1 10.4 11.1V8.7C10.4 8.2 10.2 7.9 9.7 7.9C9.2 7.9 8.9 8.3 8.9 8.9V11.1A.3.3 0 0 1 8.6 11.4H7.5A.3.3 0 0 1 7.2 11.1V6.9A.3.3 0 0 1 7.5 6.6Z" />
            </svg>
          </a>
        </div>
        <div class="frame-68">
          <a href="mailto:hello@azzum.studio" class="link-block-6 nav-icon-link w-inline-block" aria-label="Email" title="Email">
            <svg class="nav-icon" viewBox="0 0 14 14" width="16" height="16" fill="none" aria-hidden="true" focusable="false">
              <path fill="currentColor" fill-rule="evenodd" transform="translate(7 7) scale(.86) translate(-7 -7)" clip-rule="evenodd" d="M0 2.75a1.5 1.5 0 0 1 1.5 -1.5h11a1.5 1.5 0 0 1 1.5 1.5v0.342L7.383 7.504A0.72 0.72 0 0 1 7 7.607a0.72 0.72 0 0 1 -0.383 -0.103L0 3.092V2.75Zm0 1.844v6.656a1.5 1.5 0 0 0 1.5 1.5h11a1.5 1.5 0 0 0 1.5 -1.5V4.594L8.073 8.546l-0.005 0.004A1.966 1.966 0 0 1 7 8.857c-0.375 0 -0.753 -0.102 -1.068 -0.307l-0.005 -0.004L0 4.594Z" />
            </svg>
          </a>
        </div>
        <div class="frame-68">
          <a href="https://calendly.com/auz-naeem/introduction-meeting" target="_blank" rel="noopener" class="link-block-6 nav-cta w-inline-block" aria-label="Book a call (opens in a new tab)">
            <div class="navbar-label">Book a call ↗</div>
          </a>
        </div>
      </div>
    </div>

    <script is:inline src={`/js/site.js?v=${assetVersion}`} defer></script>
  </body>
</html>
