---
export interface Props {
  title: string;
  description: string;
  ogImage?: string;
  bodyClass?: string;
  isHome?: boolean;
}

const {
  title,
  description,
  ogImage = 'https://cdn.prod.website-files.com/6659888a1845a6ee299bdaa6/68e4110855d244b0b7f56545_openg.png',
  bodyClass = 'body-2',
  isHome = false,
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <link href="/css/normalize.css" rel="stylesheet" />
    <link href="/css/webflow-base.css" rel="stylesheet" />
    <link href="/css/azzum-studio.webflow.css" rel="stylesheet" />

    <link href="/images/favicon.png" rel="shortcut icon" type="image/x-icon" />
    <link href="/images/webclip.png" rel="apple-touch-icon" />

    <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>
    <script is:inline src="https://cdn.jsdelivr.net/gh/timothydesign/script/split-type.js"></script>
    <script is:inline src="https://unpkg.com/lenis@1.1.2/dist/lenis.min.js"></script>

    <style is:global>
      /* Base font size for larger screens */
      html {
        font-size: 16px;
      }
      /* Medium screens */
      @media (max-width: 1200px) {
        html {
          font-size: 14px;
        }
      }
      /* Small screens */
      @media (max-width: 992px) {
        html {
          font-size: 14px;
        }
      }
      /* Extra small screens */
      @media (max-width: 768px) {
        html {
          font-size: 13px;
        }
      }
      html.lenis,
      html.lenis body {
        height: auto;
      }
      .lenis.lenis-smooth {
        scroll-behavior: auto !important;
      }
      .lenis.lenis-smooth [data-lenis-prevent] {
        overscroll-behavior: contain;
      }
      .lenis.lenis-stopped {
        overflow: hidden;
      }
      .lenis.lenis-smooth iframe {
        pointer-events: none;
      }
      body::-webkit-scrollbar {
        display: none;
      }
      ul,
      ol {
        list-style-type: disc !important;
        list-style-position: outside !important;
        padding-left: 20px;
      }
      ul li,
      ol li {
        display: list-item !important;
        list-style-type: disc !important;
        list-style-position: outside !important;
      }
      ul ul,
      ol ol {
        list-style-type: circle !important;
        list-style-position: outside !important;
      }
      ul ul li,
      ol ol li {
        display: list-item !important;
        list-style-type: circle !important;
        list-style-position: outside !important;
      }

      /* Text-split typewriter reveal (SplitType + GSAP), see /js/site.js */
      html:not(.w-editor) [data-text-split] {
        visibility: hidden;
      }
      .char {
        display: inline-block;
      }
      .word {
        white-space: nowrap;
      }

      /* Scroll-into-view fade/blur reveal, replaces Webflow's IX2
         "SCROLL_INTO_VIEW -> FADE_EFFECT" interaction. See /js/site.js */
      [data-reveal] {
        transition: opacity 0.6s ease, filter 0.6s ease;
      }
      [data-reveal="blur"] {
        opacity: 0;
        filter: blur(20px);
      }
      [data-reveal="fade"] {
        opacity: 0;
      }
      [data-reveal].is-visible {
        opacity: 1;
        filter: blur(0);
      }
    </style>
  </head>
  <body class={bodyClass}>
    <div class="div-block-21">
      <div class="bottomnav">
        <a href="/" class="link-block-7 w-inline-block" aria-current={isHome ? 'page' : undefined}>
          <div class="navbar-label">Azzum Naeem</div>
        </a>
        <div class="timezone">
          <div class="label-final">spots 2026<br /></div>
          <div class="navbar-label time"><span class="hiddenhyphen"> </span>(nyc)</div>
        </div>
      </div>
    </div>

    <slot />

    <div class="topnav">
      <div class="div-block-22">
        <div class="frame-68">
          <a href="/" class="link-block-6 w-inline-block" aria-current={isHome ? 'page' : undefined}>
            <div class="navbar-label">work</div>
          </a>
        </div>
        <div class="frame-68">
          <a href="https://www.linkedin.com/in/azzum-naeem-a23514175" class="link-block-6 w-inline-block">
            <div class="navbar-label">linkedin</div>
          </a>
        </div>
        <div class="frame-68">
          <a href="https://calendly.com/auz-naeem/introduction-meeting" class="link-block-6 w-inline-block">
            <div class="navbar-label">Book a call ↗</div>
          </a>
        </div>
      </div>
    </div>

    <script is:inline src="/js/site.js" defer></script>
  </body>
</html>
